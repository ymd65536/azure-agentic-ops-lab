@page "/Error"
@using System.Diagnostics

<PageTitle>エラー</PageTitle>

<h1 class="text-danger">エラー</h1>
<h2 class="text-danger">リクエストの処理中にエラーが発生しました。</h2>

@if (ShowRequestId)
{
    <p>
        <strong>リクエストID:</strong> <code>@RequestId</code>
    </p>
}

<h3>開発モード</h3>
<p>
    環境を <strong>Development</strong> に切り替えると、発生したエラーの詳細情報が表示されます。
</p>
<p>
    <strong>Development 環境はデプロイ済みアプリケーションでは有効にしないでください。</strong>
    例外に含まれる機微情報がエンドユーザーに表示される恐れがあります。
    ローカルでのデバッグでは、環境変数 <strong>ASPNETCORE_ENVIRONMENT</strong> を <strong>Development</strong> に設定して
    アプリを再起動することで <strong>Development</strong> 環境を有効にできます。
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
