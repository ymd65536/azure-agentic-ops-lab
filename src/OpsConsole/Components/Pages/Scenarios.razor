@page "/scenarios"
@rendermode InteractiveServer
@inject ScenarioCatalog Catalog
@inject ScenarioLauncher Launcher
@inject NavigationManager Navigation

<PageTitle>シナリオ - Agentic Ops Console</PageTitle>

<h1>シナリオ</h1>
<p class="lede">
    バージョン管理されたシナリオを稼働中のシステムに対して開始します。インシデントには実行ごとの
    識別子が付与されるため、IncidentApi の重複防止機構と衝突せずにシナリオを再実行できます。
</p>

@if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}

<section class="card">
    <label>
        モック検証値
        <select @bind="_verificationValue">
            <option value="healthy">healthy（検証成功）</option>
            <option value="unhealthy">unhealthy（検証失敗）</option>
        </select>
    </label>
    <p class="muted">
        復旧後に、モック検証ランナーが各対象サービスについて報告する値です。
    </p>
</section>

@if (Catalog.Scenarios.Count == 0)
{
    <p>シナリオフィクスチャが見つかりませんでした。</p>
}
else
{
    @foreach (ScenarioFixture scenario in Catalog.Scenarios)
    {
        <section class="card">
            <h2>@scenario.Name</h2>
            <p>@scenario.Incident.Title</p>
            <p class="muted">@scenario.Incident.Description</p>
            <dl class="summary-grid">
                <div>
                    <span class="muted">影響サービス</span>
                    <div>@string.Join(", ", scenario.Incident.AffectedServices)</div>
                </div>
                <div><span class="muted">重大度</span><div>@scenario.Incident.Severity</div></div>
                <div><span class="muted">証拠数</span><div>@scenario.Evidence.Count</div></div>
                <div><span class="muted">期待される最終状態</span><div>@(scenario.ExpectedFinalState ?? "-")</div></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(scenario.ExpectedNotes))
            {
                <p class="muted">@scenario.ExpectedNotes</p>
            }
            <button class="button" disabled="@_launchInFlight" @onclick="() => StartAsync(scenario.Name)">
                シナリオを実行
            </button>
        </section>
    }
}

@code {
    private string _verificationValue = "healthy";
    private bool _launchInFlight;
    private string? _error;

    private async Task StartAsync(string scenarioName)
    {
        _launchInFlight = true;
        try
        {
            string incidentId = await Launcher.StartAsync(scenarioName, _verificationValue, CancellationToken.None);
            Navigation.NavigateTo($"/incidents/{Uri.EscapeDataString(incidentId)}");
        }
        catch (HttpRequestException exception)
        {
            _error = $"シナリオの開始に失敗しました: {exception.Message}";
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _launchInFlight = false;
        }
    }
}
