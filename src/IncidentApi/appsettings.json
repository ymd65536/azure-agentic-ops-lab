{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IncidentApi": {
    "PromptsRoot": "prompts",
    "KnowledgeBasePath": "knowledge/knowledge-base.json",
    "ApprovalTimeoutSeconds": 900
  },
  "AgentRuntime": {
    "Mode": "Deterministic",
    "RemoteModel": {
      "Endpoint": "",
      "ModelId": "",
      "AuthMode": "DefaultAzureCredential",
      "ApiKeySecretName": null,
      "TimeoutSeconds": 30,
      "MaxAttempts": 2
    },
    "Shadow": {
      "TimeoutSeconds": 30,
      "EvaluationOutputDirectory": "results/evaluations"
    }
  },
  "Dapr": {
    "Enabled": false,
    "PubSubName": "incident-pubsub",
    "TopicName": "incident-lifecycle"
  },
  "OpenTelemetry": {
    "ServiceName": "incident-api",
    "OtlpEndpoint": ""
  },
  "Workflow": {
    "Engine": "InProcess"
  }
}
