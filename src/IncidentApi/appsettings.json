{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IncidentApi": {
    "PromptsRoot": "prompts",
    "KnowledgeBasePath": "knowledge/knowledge-base.json",
    "ApprovalTimeoutSeconds": 900
  },
  "Dapr": {
    "Enabled": false,
    "PubSubName": "incident-pubsub",
    "TopicName": "incident-lifecycle"
  },
  "OpenTelemetry": {
    "ServiceName": "incident-api",
    "OtlpEndpoint": ""
  }
}
